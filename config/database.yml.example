default: &default
  adapter: postgresql
  encoding: unicode
  host: 127.0.0.1
  port: 5432
  username: bibliotk
  password: <%= ENV["DB_PASSWORD"] %>
  pool: <%= ENV.fetch("RAILS_MAX_THREADS", 5) %>

development:
  <<: *default
  database: bibliotk_development

test:
  <<: *default
  database: bibliotk_test

production:
  <<: *default
  database: bibliotk_production
