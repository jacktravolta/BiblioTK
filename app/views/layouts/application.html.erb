<!DOCTYPE html>
<html>
<head>
  <title>Bibliotk — Corporate Library</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">
  <style>body{font-family:'Inter',sans-serif;background:#f8fafc;color:#0f172a}.brand{font-family:'Merriweather',serif;}</style>
</head>
<body>
<header class="bg-white border-bottom sticky-top">
  <div class="container py-3 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <div style="background:#0f172a;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">B</div>
      <div><a href="/" class="text-decoration-none text-dark brand fs-5 fw-bold">Bibliotk</a>
      <div class="text-uppercase" style="font-size:0.65rem;letter-spacing:1.5px;color:#64748b;">Corporate Edition • O(1)</div></div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/books" class="text-decoration-none text-muted small fw-medium">Catálogo</a>
      <% if defined?(current_user) && current_user&.admin? %>
        <a href="/users" class="btn btn-sm" style="background:#f1f5f9;color:#0f172a;border:1px solid #e2e8f0;border-radius:8px;">👑 Usuarios</a>
        <span class="badge" style="background:#0f172a;color:white;">ADMIN</span>
      <% end %>
      <span class="badge" style="background:#f1f5f9;color:#334155;border:1px solid #e2e8f0;"><%= Book.count %> libros</span>
      <% if defined?(current_user) && current_user %>
        <span class="small text-muted"><%= current_user.name %> (<%= current_user.role %>)</span>
        <%= button_to "Salir", "/logout", method: :delete, class: "btn btn-sm", style: "background:#0f172a;color:white;border-radius:8px;" %>
      <% else %>
        <a href="/login" class="btn btn-sm" style="background:#0f172a;color:white;border-radius:8px;">Acceder</a>
      <% end %>
    </div>
  </div>
</header>
<div class="w-100" style="background:#0f172a;color:white;"><div class="container py-4"><div class="small text-uppercase" style="letter-spacing:2px;color:#94a3b8;">Sistema Corporativo • Ban = Reconciliación O(1) Automática</div><h4 class="m-0 brand">Evaluación verificada. Rendimiento O(1).</h4></div></div>
<div class="container py-4">
  <% if flash[:notice] %><div class="alert alert-light border" style="border-left:4px solid #0f172a!important;"><%= flash[:notice] %></div><% end %>
  <% if flash[:alert] %><div class="alert alert-light border" style="border-left:4px solid #dc2626!important;"><%= flash[:alert] %></div><% end %>
  <%= yield %>
</div>
</body>
</html>
