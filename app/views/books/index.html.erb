<div class="container py-3">
<div class="row g-2 mb-3">
  <div class="col-6 col-md-3"><div class="bg-white border rounded-3 p-2 h-100" style="border-left:4px solid #0f172a!important;"><div class="small text-muted" style="font-size:0.6rem;">HOME O(1)</div><b style="font-size:0.9rem;"><%= ((@home_timing || 0)*1000).round(2) %> ms</b></div></div>
  <div class="col-6 col-md-3"><div class="bg-white border rounded-3 p-2 h-100" style="border-left:4px solid #b45309!important;"><div class="small text-muted" style="font-size:0.6rem;">BENCH 10x</div><b style="font-size:0.9rem;"><%= ((@o1_benchmark || 0)*1000).round(2) %> ms</b></div></div>
  <div class="col-12 col-md-6"><div class="bg-white border rounded-3 p-2 h-100" style="border-left:4px solid #166534!important;"><div class="small text-muted" style="font-size:0.6rem;">DATA</div><b style="font-size:0.75rem; word-break:break-all;"><%= @data_gen_timing ? @data_gen_timing.truncate(80) : "benchmark_500k.rb" %></b></div></div>
</div>

  <div class="d-flex justify-content-between align-items-end mb-3">
    <h4 class="fw-bold m-0" style="font-size:1.2rem;">Libros (<%= @total_count %>)</h4>
    <small class="text-muted">Pág <%= @page %>/<%= @total_pages %></small>
  </div>

  <div class="row g-3">
    <% @books.each do |book| %>
      <% avg = book.average_rating || 0 %>
      <% full = avg.floor %>
      <% half = (avg - full) >= 0.5 ? 1 : 0 %>
      <% empty = 5 - full - half %>
      <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
        <div class="card h-100 border-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
          <a href="<%= book_path(book) %>">
            <img src="https://picsum.photos/seed/book-<%= book.id %>/600/400" class="card-img-top" style="height:220px; object-fit:cover;" loading="lazy" onerror="this.src='https://picsum.photos/600/400?random=<%= book.id %>'">
          </a>
          <div class="card-body p-3">
            <h6 class="card-title mb-1" style="font-size:0.95rem;"><%= link_to book.title.truncate(40), book_path(book), class: "text-decoration-none text-dark fw-bold" %></h6>
            <small class="text-muted"><%= book.author.truncate(25) %></small>
            
            <div class="mt-2">
              <% if book.valid_reviews_count < 3 %>
                <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fcd34d; font-size:0.65rem;">Reseñas Insuficientes</span>
                <div class="small text-muted mt-1" style="font-size:0.7rem;"><%= book.valid_reviews_count %> reseña(s)</div>
              <% else %>
                <!-- ESTRELLAS MODO ICONO -->
                <div class="d-flex align-items-center gap-1">
                  <span style="color:#f59e0b; font-size:1rem; letter-spacing:1px;">
                    <%= "★" * full %><% if half == 1 %><%= "⯨" %><% end %><span style="color:#e5e7eb;"><%= "★" * empty %></span>
                  </span>
                  <b style="font-size:0.85rem;"><%= avg %></b>
                </div>
                <div class="small text-muted" style="font-size:0.7rem;"><%= book.valid_reviews_count %> reseñas • <%= book.valid_total_stars %> pts</div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-4"><ul class="pagination justify-content-center flex-wrap">
      <% (1..@total_pages).each do |p| %>
        <li class="page-item <%= 'active' if p == @page %>"><%= link_to p, books_path(page: p), class: "page-link" %></li>
      <% end %>
    </ul></nav>
  <% end %>
</div>
<style>
@media (max-width: 576px) {
  .card-img-top { height: 280px !important; }
}
</style>
