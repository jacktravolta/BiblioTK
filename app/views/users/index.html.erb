<div class="container py-4">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h4 class="fw-bold m-0">Gestión de Usuarios</h4>
      <div class="small text-muted">Paginado • <%= @total_count %> usuarios totales • Página <%= @page %> de <%= @total_pages %></div>
    </div>
    <span class="badge" style="background:#f1f5f9;color:#334155;border:1px solid #e2e8f0;"><%= @total_count %> total</span>
  </div>

  <div class="card border-0 shadow-sm" style="border-radius:16px;">
    <div class="table-responsive">
      <table class="table table-hover align-middle m-0">
        <thead style="background:#f8fafc;">
          <tr>
            <th>ID</th><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |u| %>
            <tr>
              <td><%= u.id %></td>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td><span class="badge bg-light text-dark border"><%= u.role %></span></td>
              <td>
                <% if u.banned? %>
                  <span class="badge" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;">BANEADO</span>
                <% else %>
                  <span class="badge" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">ACTIVO</span>
                <% end %>
              </td>
              <td class="d-flex gap-2">
                <%= link_to "Ver", user_path(u), class: "btn btn-sm btn-outline-secondary" %>
                <% if u.banned? %>
                  <%= button_to "Reactivar", unban_user_path(u), method: :post, class: "btn btn-sm btn-outline-success" %>
                <% else %>
                  <% if current_user.id != u.id %>
                    <%= button_to "Suspender", ban_user_path(u), method: :post, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "¿Banear a #{u.email}? Recalculará ratings O(1)" } } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= render partial: "shared/paginator", locals: { current_page: @page, total_pages: @total_pages, total_count: @total_count, per_page: @per_page, param_name: :page } rescue nil %>
    <% if @total_pages > 1 %>
      <nav>
        <ul class="pagination">
          <% (1..@total_pages).each do |p| %>
            <li class="page-item <%= 'active' if p == @page %>"><%= link_to p, users_path(page: p), class: "page-link" %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
</div>
