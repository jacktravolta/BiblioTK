    <h4 class="fw-bold m-0">Catálogo Corporativo — 50 por página (PDF)</h4>
    <div class="small text-muted">Requerimiento PDF: home con 50 libros, O(1) con valid_* sin AVG()</div>
  </div>
  <div class="small text-muted">Página <%= @page %> de <%= @total_pages %> • <%= @total_count %> libros</div>
</div>

<!-- BANNER TIMING CORPORATIVO -->
<div class="row g-3 mb-4">
