    <div class="bg-white border rounded-3 p-3" style="border-radius:12px!important;border-left:4px solid #0f172a!important;">
      <div class="small text-uppercase text-muted" style="letter-spacing:1px;font-size:0.7rem;">Home O(1) - Tiempo de Query</div>
      <div class="fw-bold" style="font-size:1.4rem;"><%= (@home_timing*1000).round(2) %> ms</div>
      <div class="small text-muted">SELECT 50 libros con valid_* • Página <%= @page %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="bg-white border rounded-3 p-3" style="border-radius:12px!important;border-left:4px solid #b45309!important;">
      <div class="small text-uppercase text-muted" style="letter-spacing:1px;font-size:0.7rem;">Benchmark O(1) - 10x Home</div>
      <div class="fw-bold" style="font-size:1.4rem;"><%= (@o1_benchmark*1000).round(2) %> ms total</div>
      <div class="small text-muted"><%= (@o1_benchmark/10*1000).round(2) %> ms promedio por request • Independiente de reseñas</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="bg-white border rounded-3 p-3" style="border-radius:12px!important;border-left:4px solid #166534!important;">
