      <% else %>
        <div class="fw-bold" style="font-size:1rem;">No registrado</div>
        <div class="small text-muted">Corre benchmark_500k.rb para medir</div>
      <% end %>
    </div>
  </div>
</div>

<div class="row g-4">
<% @books.each do |b| %>
  <div class="col-md-2-4" style="width:20%;"> <!-- 5 por fila = 50 por página en 10 filas -->
    <div class="card h-100 border-0" style="border:1px solid #e2e8f0!important;border-radius:12px;overflow:hidden;">
      <div style="position:relative;">
        <img src="https://picsum.photos/seed/book<%= b.id %>/300/400" style="width:100%;height:180px;object-fit:cover;">
        <% if b.title == 'Libro Popular' %>
          <span class="badge" style="position:absolute;top:8px;left:8px;background:#0f172a;color:white;font-size:0.6rem;">POPULAR • <%= b.valid_reviews_count %></span>
        <% end %>
      </div>
      <div class="card-body p-2">
        <div class="small text-muted" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.5px;"><%= b.author.truncate(20) %></div>
        <a href="/books/<%= b.id %>?page=<%= @page %>" class="text-decoration-none text-dark fw-semibold small" style="line-height:1.2;display:block;min-height:32px;font-size:0.85rem;"><%= b.title.truncate(40) %></a>
        <div class="mt-1 d-flex align-items-center gap-1">
