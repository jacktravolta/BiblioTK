            <span class="small fw-semibold" style="font-size:0.75rem;"><%= b.average_rating %></span>
          <% else %>
            <span class="badge" style="background:#f1f5f9;color:#64748b;font-size:0.6rem;"><%= b.valid_reviews_count >=1 ? "#{b.valid_reviews_count} rev" : "Insuf." %></span>
          <% end %>
        </div>
        <div class="small text-muted" style="font-size:0.65rem;">ID <%= b.id %> • ⭐ <%= b.valid_total_stars %></div>
      </div>
    </div>
  </div>
<% end %>
</div>

